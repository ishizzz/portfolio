# Spotify "now playing" widget (components/NowPlaying.js).
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
#
# 1. Create an app at https://developer.spotify.com/dashboard
#    - Add http://127.0.0.1:8888/callback as a Redirect URI in the app settings.
#    - Copy the Client ID and Client Secret below.
# 2. Run: node scripts/get-spotify-token.mjs
#    - It opens Spotify, you approve once, and it prints your refresh token.
# 3. Paste the refresh token below.
# 4. Add these same three values to your hosting provider's environment variables
#    so it works in production, not just locally.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
